# ── Database (required) ─────────────────────────────────────────────
# Any PostgreSQL 14+ connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Authentication (required) ───────────────────────────────────────
# 32-byte key used to encrypt provider tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Set to "true" ONLY for local development / previews. Enables a shared passwordless
# guest account on the login page. Leave unset in production.
ALLOW_GUEST_LOGIN=

# Public origin used for Open Graph image URLs and share links.
# Example: https://vinyl.example.com
NEXT_PUBLIC_APP_URL=

# ── Spotify (optional) ──────────────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard and add the
# redirect URI below to its settings. Spotify's API only exposes the
# last 50 plays; for full history use the JSON export import instead.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/spotify/callback

# ── Last.fm (optional) ──────────────────────────────────────────────
# https://www.last.fm/api/account/create
LASTFM_API_KEY=

# ── Apple Music (optional) ──────────────────────────────────────────
# A MusicKit developer token (JWT). Note: Apple's "recently played"
# endpoint returns no play timestamps, so it cannot provide real history.
APPLE_DEVELOPER_TOKEN=
